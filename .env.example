## Local secrets (do not commit .env)
#
# Copy this file to `.env` and fill in values.
#
# Google Maps JavaScript API key (only needed for the legacy `towers.html` Google Maps page)
GOOGLE_MAPS_API_KEY=
#
# OpenCellID key (optional; only used when running `tower_anomaly_dashboard.py --opencellid`)
OPENCELLID_KEY=
#
# WiGLE API credentials (optional; used by the tower drawer "Check WiGLE" button)
WIGLE_API_NAME=
WIGLE_API_TOKEN=
